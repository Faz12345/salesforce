# Copy this file to .env and fill in real values. Never commit .env.

# A random string used to sign Flask session cookies / flash messages.
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=use-a-different-long-random-string
JWT_ACCESS_MINUTES=30

# MongoDB connection string.
# Local Mongo:        mongodb://localhost:27017
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=support_crm

# Set to "true" to run against an in-memory mongomock database instead of
# a real MongoDB server (handy for quick local testing, no setup required).
# Leave "false" (or unset) for production / real deployments.
USE_MONGOMOCK=false

# Optional: create the first administrator automatically on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Local-only convenience: return a reset token in the forgot-password response.
# Keep false in production and deliver reset links through an email provider.
EXPOSE_RESET_TOKEN=false

# SMTP email delivery (Gmail: smtp.gmail.com + a Google App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-email@gmail.com
APP_BASE_URL=http://localhost:5000

# Port Flask binds to. Most PaaS providers (Railway, Render) inject this
# automatically - you usually don't need to set it yourself.
PORT=5000

# "false" in production
FLASK_DEBUG=true
